# Neon / PostgreSQL Database URL
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# Application Name
NEXT_PUBLIC_APP_NAME="نظام النخبة الأهلية لإدارة المدارس"

# JWT Secret Key (HMAC-SHA256)
JWT_SECRET="replace_with_a_strong_random_jwt_secret_key"

# Optional: Initial Super Admin Password
SUPER_ADMIN_INITIAL_PASSWORD="ChangeMe@2025!StrongSecret"
